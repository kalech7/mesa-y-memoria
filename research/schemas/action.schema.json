{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "slot"
          ],
          "properties": {
            "action": {
              "const": "PROCEED"
            },
            "slot": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "slot"
          ],
          "properties": {
            "action": {
              "const": "ASK"
            },
            "slot": {
              "enum": [
                "TEMPORAL_SCOPE",
                "CURRENT_CONTEXT",
                "VALID_UNTIL",
                "GENERIC"
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "value",
        "branches",
        "evidence_ids"
      ],
      "properties": {
        "mode": {
          "enum": [
            "ANSWER",
            "CONDITIONALIZE",
            "DEFER"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition",
              "value"
            ],
            "properties": {
              "condition": {
                "type": [
                  "string",
                  "object"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "ANSWER"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "branches": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op"
                ],
                "properties": {
                  "op": {
                    "const": "NOOP"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "record"
                ],
                "properties": {
                  "op": {
                    "enum": [
                      "ADD",
                      "SUPERSEDE",
                      "MARK_UNRESOLVED"
                    ]
                  },
                  "target_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "record": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "attribute",
                      "value",
                      "scope",
                      "status",
                      "source_turn_ids",
                      "evidence_quotes"
                    ],
                    "properties": {
                      "memory_id": {
                        "type": "string"
                      },
                      "attribute": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "scope": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "session_id",
                          "context",
                          "valid_from",
                          "valid_until_exclusive"
                        ],
                        "properties": {
                          "kind": {
                            "enum": [
                              "session",
                              "interval",
                              "contextual",
                              "ongoing",
                              "unknown"
                            ]
                          },
                          "session_id": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "context": {
                            "type": [
                              "string",
                              "object",
                              "null"
                            ]
                          },
                          "valid_from": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date"
                          },
                          "valid_until_exclusive": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date"
                          }
                        }
                      },
                      "status": {
                        "enum": [
                          "confirmed",
                          "unresolved"
                        ]
                      },
                      "source_turn_ids": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      },
                      "evidence_quotes": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "turn_id",
                            "text"
                          ],
                          "properties": {
                            "turn_id": {
                              "type": "string"
                            },
                            "text": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "supersedes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "recorded_at": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
