{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "root_id",
    "latent_world_id",
    "realization_id",
    "split",
    "scenario_family",
    "initial_memory",
    "user_messages",
    "current_query",
    "future_query",
    "replies",
    "truth"
  ],
  "properties": {
    "root_id": {
      "type": "string"
    },
    "latent_world_id": {
      "type": "string"
    },
    "realization_id": {
      "type": "string"
    },
    "split": {
      "enum": [
        "dev_smoke",
        "train",
        "validation",
        "test_id",
        "test_ood",
        "test_external"
      ]
    },
    "scenario_family": {
      "enum": [
        "F0",
        "F1",
        "F2",
        "F3",
        "F4"
      ]
    },
    "initial_memory": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attribute",
          "value",
          "scope",
          "status",
          "source_turn_ids",
          "evidence_quotes"
        ],
        "properties": {
          "memory_id": {
            "type": "string"
          },
          "attribute": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "session_id",
              "context",
              "valid_from",
              "valid_until_exclusive"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "session",
                  "interval",
                  "contextual",
                  "ongoing",
                  "unknown"
                ]
              },
              "session_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "context": {
                "type": [
                  "string",
                  "object",
                  "null"
                ]
              },
              "valid_from": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "valid_until_exclusive": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            }
          },
          "status": {
            "enum": [
              "confirmed",
              "unresolved"
            ]
          },
          "source_turn_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_quotes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "turn_id",
                "text"
              ],
              "properties": {
                "turn_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recorded_at": {
            "type": "string"
          }
        }
      }
    },
    "current_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribute",
        "date",
        "session_id",
        "context"
      ],
      "properties": {
        "attribute": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "session_id": {
          "type": "string"
        },
        "context": {
          "type": [
            "string",
            "object",
            "null"
          ]
        }
      }
    },
    "future_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribute",
        "date",
        "session_id",
        "context"
      ],
      "properties": {
        "attribute": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "session_id": {
          "type": "string"
        },
        "context": {
          "type": [
            "string",
            "object",
            "null"
          ]
        }
      }
    },
    "user_messages": {
      "type": "array"
    },
    "replies": {
      "type": "object"
    },
    "truth": {
      "type": "object"
    }
  }
}
