{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attribute",
    "value",
    "scope",
    "status",
    "source_turn_ids",
    "evidence_quotes"
  ],
  "properties": {
    "memory_id": {
      "type": "string"
    },
    "attribute": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session_id",
        "context",
        "valid_from",
        "valid_until_exclusive"
      ],
      "properties": {
        "kind": {
          "enum": [
            "session",
            "interval",
            "contextual",
            "ongoing",
            "unknown"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": [
            "string",
            "object",
            "null"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "valid_until_exclusive": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "status": {
      "enum": [
        "confirmed",
        "unresolved"
      ]
    },
    "source_turn_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_quotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_id",
          "text"
        ],
        "properties": {
          "turn_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recorded_at": {
      "type": "string"
    }
  }
}
